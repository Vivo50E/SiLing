#!/usr/bin/env python3
"""Portable SiLing command launcher.

This file may be invoked directly from the repository or through a symlink in
~/.local/bin.  It resolves the real repository path, then prefers the project's
virtual environment so every subcommand uses the same dependencies as the
Dashboard.
"""

from __future__ import annotations

import os
from pathlib import Path
import sys


REPO_DIR = Path(__file__).resolve().parent
VENV_PYTHON = REPO_DIR / ".venv" / "bin" / "python"

if VENV_PYTHON.is_file() and Path(sys.executable).resolve() != VENV_PYTHON.resolve():
    os.execv(
        str(VENV_PYTHON),
        [str(VENV_PYTHON), str(REPO_DIR / "orchestrator.py"), *sys.argv[1:]],
    )

sys.path.insert(0, str(REPO_DIR))

from agent_orchestrator.cli import main  # noqa: E402


if __name__ == "__main__":
    main()
